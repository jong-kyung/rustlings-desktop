{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rustlings Desktop",
  "version": "0.1.0",
  "identifier": "io.github.jong-kyung.lustlings-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vp run dev",
    "beforeBuildCommand": "vp run build"
  },
  "app": {
    "windows": [
      {
        "title": "lustlings-desktop",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "font-src": ["'self'"],
        "img-src": ["'self'", "asset:", "http://asset.localhost"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "worker-src": ["'self'"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "frame-src": ["'none'"],
        "frame-ancestors": ["'none'"],
        "form-action": ["'none'"],
        "navigate-to": ["'self'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "connect-src": [
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:5173",
          "ws://localhost:5173"
        ],
        "font-src": ["'self'"],
        "img-src": ["'self'", "asset:", "http://asset.localhost"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "worker-src": ["'self'"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "frame-src": ["'none'"],
        "frame-ancestors": ["'none'"],
        "form-action": ["'none'"],
        "navigate-to": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/rustlings-6.5.0"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
