{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "lustlings-desktop",
  "version": "0.1.0",
  "identifier": "io.github.jong-kyung.lustlings-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vp run dev",
    "beforeBuildCommand": "vp run build"
  },
  "app": {
    "windows": [
      {
        "title": "lustlings-desktop",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/rustlings-6.5.0"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
